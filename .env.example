# Claude, for task chat and inbox parsing
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Gmail drafts. Create a "Desktop app" OAuth client in Google Cloud, fill these two,
# then run `node scripts/google-auth.js` to write GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# PORT=4141
# SYNC=off   disables git pull/push of data files
